{
  "name": "relistix/health-checker",
  "description": "Laravel package that integrates Healthchecks.io to monitor queue and mail-server availability and provides a configurable ping URL builder.",
  "keywords": [
    "laravel",
    "healthchecks",
    "healthchecks.io",
    "monitoring",
    "queue",
    "mail",
    "uptime"
  ],
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Ivan Iliev",
      "email": "ivan@relistix.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/contracts": "^10.0|^11.0|^12.0",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "illuminate/console": "^10.0|^11.0|^12.0",
    "illuminate/queue": "^10.0|^11.0|^12.0",
    "illuminate/mail": "^10.0|^11.0|^12.0",
    "illuminate/http": "^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "phpunit/phpunit": "^10.5|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Relistix\\HealthChecker\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Relistix\\HealthChecker\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Relistix\\HealthChecker\\HealthCheckerServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  }
}
